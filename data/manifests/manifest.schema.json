{
  "$defs": {
    "Assets": {
      "additionalProperties": false,
      "properties": {
        "science_fits": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Science cutout (FITS, original HDUs) path",
          "title": "Science Fits"
        },
        "display_png": {
          "description": "8-bit display rendering; never used for measurement",
          "title": "Display Png",
          "type": "string"
        },
        "display_stretch": {
          "description": "Stretch used for display_png",
          "title": "Display Stretch",
          "type": "string"
        }
      },
      "required": [
        "science_fits",
        "display_png",
        "display_stretch"
      ],
      "title": "Assets",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "unreviewed",
            "needs_followup",
            "known_object",
            "likely_artifact",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "kind": {
          "enum": [
            "new_source_like",
            "variable_like",
            "dipole_like",
            "artifact_like"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        },
        "ra_deg": {
          "exclusiveMaximum": 360.0,
          "minimum": 0.0,
          "title": "Ra Deg",
          "type": "number"
        },
        "dec_deg": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Dec Deg",
          "type": "number"
        },
        "pixel_x": {
          "description": "0-based column on the shared grid",
          "title": "Pixel X",
          "type": "number"
        },
        "pixel_y": {
          "description": "0-based row on the shared grid (FITS orientation)",
          "title": "Pixel Y",
          "type": "number"
        },
        "measurements": {
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "light_curve": {
          "description": "Residual at this position, all epochs",
          "items": {
            "$ref": "#/$defs/LightCurvePoint"
          },
          "title": "Light Curve",
          "type": "array"
        },
        "evidence": {
          "description": "Measured facts supporting/refuting the candidate",
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "caveats": {
          "items": {
            "type": "string"
          },
          "title": "Caveats",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "status",
        "kind",
        "observation_ids",
        "ra_deg",
        "dec_deg",
        "pixel_x",
        "pixel_y",
        "measurements",
        "light_curve",
        "evidence",
        "caveats",
        "method"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Comparison": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "title": "Reference Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "compatible",
            "incompatible",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "reasons": {
          "description": "Every failed or unknown check, human readable",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "reference_id",
        "target_id",
        "status",
        "reasons"
      ],
      "title": "Comparison",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "mission": {
          "enum": [
            "SPHEREx",
            "SIMULATED"
          ],
          "title": "Mission",
          "type": "string"
        },
        "archive": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "e.g. 'IRSA'; null for simulations",
          "title": "Archive"
        },
        "collection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Archive collection, e.g. 'spherex_qr'",
          "title": "Collection"
        },
        "data_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Release label exactly as the archive states it",
          "title": "Data Release"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "acknowledgement": {
          "title": "Acknowledgement",
          "type": "string"
        }
      },
      "required": [
        "mission",
        "archive",
        "collection",
        "data_release",
        "citation",
        "acknowledgement"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "Difference": {
      "additionalProperties": false,
      "properties": {
        "difference_id": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "title": "Difference Id",
          "type": "string"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "validated",
            "visualization_only"
          ],
          "title": "Status",
          "type": "string"
        },
        "reasons": {
          "description": "Why quantitative use is disabled, if it is",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "background_mjysr": {
          "description": "Background subtracted from the epoch",
          "title": "Background Mjysr",
          "type": "number"
        },
        "noise_scale": {
          "description": "Empirical rescale applied to significance",
          "exclusiveMinimum": 0.0,
          "title": "Noise Scale",
          "type": "number"
        },
        "error_floor_fraction": {
          "description": "Fractional template error added",
          "minimum": 0.0,
          "title": "Error Floor Fraction",
          "type": "number"
        },
        "threshold_sigma": {
          "exclusiveMinimum": 0.0,
          "title": "Threshold Sigma",
          "type": "number"
        },
        "display_png": {
          "description": "Significance map, diverging, clipped at display_range",
          "title": "Display Png",
          "type": "string"
        },
        "display_range_sigma": {
          "exclusiveMinimum": 0.0,
          "title": "Display Range Sigma",
          "type": "number"
        }
      },
      "required": [
        "difference_id",
        "observation_id",
        "status",
        "reasons",
        "method",
        "background_mjysr",
        "noise_scale",
        "error_floor_fraction",
        "threshold_sigma",
        "display_png",
        "display_range_sigma"
      ],
      "title": "Difference",
      "type": "object"
    },
    "Epoch": {
      "additionalProperties": false,
      "properties": {
        "mjd_mid": {
          "description": "Mid-exposure Modified Julian Date",
          "exclusiveMinimum": 0.0,
          "title": "Mjd Mid",
          "type": "number"
        },
        "time_scale": {
          "enum": [
            "utc",
            "tt",
            "tai",
            "tdb"
          ],
          "title": "Time Scale",
          "type": "string"
        },
        "exposure_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exposure S"
        },
        "source_keyword": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "FITS keyword the time came from",
          "title": "Source Keyword"
        }
      },
      "required": [
        "mjd_mid",
        "time_scale"
      ],
      "title": "Epoch",
      "type": "object"
    },
    "GeneratedBy": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "command": {
          "title": "Command",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version",
        "command"
      ],
      "title": "GeneratedBy",
      "type": "object"
    },
    "Image": {
      "additionalProperties": false,
      "properties": {
        "width_px": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "maximum": 4096,
          "title": "Height Px",
          "type": "integer"
        },
        "pixel_scale_arcsec": {
          "exclusiveMinimum": 0.0,
          "title": "Pixel Scale Arcsec",
          "type": "number"
        },
        "units": {
          "description": "Science array units, e.g. 'MJy/sr'",
          "title": "Units",
          "type": "string"
        },
        "wcs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Celestial FITS WCS cards of the science array",
          "title": "Wcs",
          "type": "object"
        }
      },
      "required": [
        "width_px",
        "height_px",
        "pixel_scale_arcsec",
        "units",
        "wcs"
      ],
      "title": "Image",
      "type": "object"
    },
    "LightCurvePoint": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "mjd_mid": {
          "title": "Mjd Mid",
          "type": "number"
        },
        "delta_flux_ujy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Aperture residual vs template; null if masked",
          "title": "Delta Flux Ujy"
        },
        "uncertainty_ujy": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uncertainty Ujy"
        }
      },
      "required": [
        "observation_id",
        "mjd_mid",
        "delta_flux_ujy",
        "uncertainty_ujy"
      ],
      "title": "LightCurvePoint",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "1-sigma; null if not available",
          "title": "Uncertainty"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "uncertainty",
        "unit"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "title": "Observation Id",
          "type": "string"
        },
        "data_kind": {
          "enum": [
            "real",
            "simulated"
          ],
          "title": "Data Kind",
          "type": "string"
        },
        "epoch": {
          "$ref": "#/$defs/Epoch"
        },
        "spectral": {
          "$ref": "#/$defs/Spectral"
        },
        "image": {
          "$ref": "#/$defs/Image"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "assets": {
          "$ref": "#/$defs/Assets"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "observation_id",
        "data_kind",
        "epoch",
        "spectral",
        "image",
        "quality",
        "assets",
        "provenance"
      ],
      "title": "Observation",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Original archive URL; required for real data",
          "title": "Source Url"
        },
        "source_id": {
          "description": "Stable archive identifier (or simulation id)",
          "title": "Source Id",
          "type": "string"
        },
        "retrieved_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved Utc"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "calibration_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Version"
        },
        "collection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Archive collection of this file",
          "title": "Collection"
        },
        "data_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Release label, e.g. 'DR1'",
          "title": "Data Release"
        },
        "processing": {
          "description": "Exact command/parameters that produced the assets",
          "title": "Processing",
          "type": "string"
        },
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "source_id",
        "processing",
        "cache_key"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Quality": {
      "additionalProperties": false,
      "properties": {
        "flags_available": {
          "title": "Flags Available",
          "type": "boolean"
        },
        "variance_available": {
          "title": "Variance Available",
          "type": "boolean"
        },
        "masked_fraction": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Masked Fraction"
        },
        "psf_fwhm_arcsec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Psf Fwhm Arcsec"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "flags_available",
        "variance_available"
      ],
      "title": "Quality",
      "type": "object"
    },
    "Spectral": {
      "additionalProperties": false,
      "properties": {
        "detector": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "SPHEREx detector/band 1-6",
          "title": "Detector"
        },
        "wavelength_center_um": {
          "description": "Wavelength at cutout center, micron",
          "exclusiveMinimum": 0.0,
          "title": "Wavelength Center Um",
          "type": "number"
        },
        "wavelength_min_um": {
          "exclusiveMinimum": 0.0,
          "title": "Wavelength Min Um",
          "type": "number"
        },
        "wavelength_max_um": {
          "exclusiveMinimum": 0.0,
          "title": "Wavelength Max Um",
          "type": "number"
        },
        "basis": {
          "description": "How wavelengths were derived; SPHEREx wavelength varies across each detector",
          "enum": [
            "spectral-wcs",
            "header",
            "simulated"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "detector",
        "wavelength_center_um",
        "wavelength_min_um",
        "wavelength_max_um",
        "basis"
      ],
      "title": "Spectral",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "ra_deg": {
          "description": "Right ascension, degrees",
          "exclusiveMaximum": 360.0,
          "minimum": 0.0,
          "title": "Ra Deg",
          "type": "number"
        },
        "dec_deg": {
          "description": "Declination, degrees",
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Dec Deg",
          "type": "number"
        },
        "frame": {
          "const": "icrs",
          "default": "icrs",
          "title": "Frame",
          "type": "string"
        },
        "radius_arcsec": {
          "description": "Cutout half-size, arcsec",
          "exclusiveMinimum": 0.0,
          "maximum": 3600.0,
          "title": "Radius Arcsec",
          "type": "number"
        }
      },
      "required": [
        "label",
        "ra_deg",
        "dec_deg",
        "radius_arcsec"
      ],
      "title": "Target",
      "type": "object"
    },
    "Template": {
      "additionalProperties": false,
      "description": "Reference image every epoch is differenced against (all observations share its grid).",
      "properties": {
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Observation Ids",
          "type": "array"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "display_png": {
          "title": "Display Png",
          "type": "string"
        },
        "science_fits": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Science Fits"
        }
      },
      "required": [
        "observation_ids",
        "method",
        "display_png",
        "science_fits"
      ],
      "title": "Template",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_id": {
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "data_kind": {
      "enum": [
        "real",
        "simulated"
      ],
      "title": "Data Kind",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "notice": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Shown prominently in the UI; required for simulations",
      "title": "Notice"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "dataset": {
      "$ref": "#/$defs/Dataset"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/Comparison"
      },
      "title": "Comparisons",
      "type": "array"
    },
    "alignment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "How epochs were resampled to one grid; null if not aligned",
      "title": "Alignment"
    },
    "template": {
      "anyOf": [
        {
          "$ref": "#/$defs/Template"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "differences": {
      "items": {
        "$ref": "#/$defs/Difference"
      },
      "title": "Differences",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "generated_by": {
      "$ref": "#/$defs/GeneratedBy"
    }
  },
  "required": [
    "schema_version",
    "manifest_id",
    "data_kind",
    "title",
    "notice",
    "target",
    "dataset",
    "observations",
    "generated_by"
  ],
  "title": "Manifest",
  "type": "object"
}
